// InternReach CRM — Prisma Schema
generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String   @map("password_hash")
  displayName  String   @default("") @map("display_name")
  createdAt    DateTime @default(now()) @map("created_at")

  companies      Company[]
  templates      Template[]
  settings       Settings?
  dailySendLogs  DailySendLog[]
  incomingEmails IncomingEmail[]
}

model Company {
  id         Int       @id @default(autoincrement())
  userId     Int       @default(1) @map("user_id")
  name       String
  tier       String?   // "High - Converted/Hired", "Medium", "Low" etc.
  statusSeen String?   // Raw status from Excel
  repliedAt  DateTime?
  stage      String    @default("pending") // pending | active | replied | interview | rejected
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user           User            @relation(fields: [userId], references: [id])
  contacts       Contact[]
  incomingEmails IncomingEmail[]

  @@unique([userId, name])
}

model Contact {
  id            Int       @id @default(autoincrement())
  companyId     Int
  name          String
  email         String    @unique
  phone         String?
  status        String    @default("pending") // pending | sent | replied | stopped | bounced
  followUpCount Int       @default(0)         // 0=not sent, 1=initial sent, 2-6=follow-ups sent
  lastSentAt    DateTime?
  stoppedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  company   Company    @relation(fields: [companyId], references: [id])
  emailLogs EmailLog[]
}

model EmailLog {
  id         Int       @id @default(autoincrement())
  contactId  Int
  type       String    // "initial" | "followup_1" | "followup_2" | ... | "followup_5"
  subject    String
  body       String
  sentAt     DateTime  @default(now())
  openedAt   DateTime?
  openCount  Int       @default(0)
  pixelId    String    @unique @default("")
  status     String    @default("sent") // sent | opened | bounced

  contact Contact @relation(fields: [contactId], references: [id])
}

model IncomingEmail {
  id           Int       @id @default(autoincrement())
  userId       Int       @default(1) @map("user_id")
  companyId    Int?
  fromEmail    String
  fromName     String?
  subject      String
  body         String
  receivedAt   DateTime  @default(now())
  aiDraftReply String?
  aiStatus     String    @default("new") // new | classifying | classified | draft_ready | replied | irrelevant
  replied      Boolean   @default(false)
  repliedAt    DateTime?
  messageId    String?   @unique       // IMAP message ID (dedup)

  user    User     @relation(fields: [userId], references: [id])
  company Company? @relation(fields: [companyId], references: [id])
}

model Template {
  id        Int      @id @default(autoincrement())
  userId    Int      @default(1) @map("user_id")
  name      String
  type      String   // "initial" | "followup_1" | "followup_2" | "followup_3" | "followup_4" | "followup_5"
  subject   String
  htmlBody  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, type])
}

model Settings {
  id              Int      @id @default(autoincrement())
  userId          Int      @unique @map("user_id")
  gmailUser       String   @default("")
  gmailAppPass    String   @default("")
  dailyLimit      Int      @default(499)
  sentToday       Int      @default(0)
  lastResetDate   String   @default("")
  pixelBaseUrl    String   @default("")
  linkedinUrl     String   @default("")
  aiBaseUrl       String   @default("http://localhost:10531/v1")
  aiModel         String   @default("gpt-5.6-sol")
  systemPrompt    String   @default("")
  sendingPaused   Boolean  @default(false)
  followUpDays    String   @default("4,8,15,22,30")
  sendWindowStart String   @default("10:30")
  sendWindowEnd   String   @default("11:59")
  followUpLimit   Int      @default(300)
  fuSentToday     Int      @default(0)
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model DailySendLog {
  id        Int      @id @default(autoincrement())
  userId    Int      @default(1) @map("user_id")
  date      String   // YYYY-MM-DD
  count     Int      @default(0)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}
